# Server Configuration
PORT=3000

# Monday.com Configuration
MONDAY_CLIENT_SECRET=your_monday_client_secret_here
MONDAY_SIGNING_SECRET=your_monday_signing_secret_here

# Database Configuration (Supabase Postgres connection string for Prisma)
# Include the `?pgbouncer=true&connection_limit=1` flags so Prisma plays well with Supabase's pooled connection.
DATABASE_URL=postgresql://postgres:your-supabase-password@db-project.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=10&sslmode=require
# Direct connection URL used by Prisma for long-running migrations (connects to port 5432)
DIRECT_URL=postgresql://postgres:your-supabase-password@db-project.supabase.co:5432/postgres?sslmode=require

# Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_SCHEMA=public

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Encryption Configuration
# Usa una stringa casuale complessa per criptare le password (minimo 32 caratteri)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_32_chars_minimum_here

# Aruba Mail Configuration
ARUBA_MAIL_HOST=mail.aruba.it
ARUBA_MAIL_PORT=465
ARUBA_MAIL_USER=your_email@aruba.it
ARUBA_MAIL_PASSWORD=your_aruba_mail_password

# Application Environment
NODE_ENV=development
