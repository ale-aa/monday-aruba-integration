# ============================================================================
# SUPABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# Database connection strings from Supabase
# Pooled connection (pgbouncer on port 6543) recommended for Prisma in serverless
DATABASE_URL="postgresql://postgres:your_password@db.your-project-id.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=10&sslmode=require"
# Direct connection (port 5432) used by Prisma migrate/db push
DIRECT_URL="postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres?sslmode=require"

# Supabase Project URL (for browser-side operations if needed)
# Get this from: Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon Key (public, safe for browser)
# Get this from: Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (SECRET - server-side only)
# Get this from: Supabase Project Settings → API → Service role key
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Schema (di default public, ma valorizzalo se usi schemi personalizzati)
SUPABASE_DB_SCHEMA="public"

# ============================================================================
# MONDAY.COM CONFIGURATION
# ============================================================================

# Monday.com secrets from Developer Center
MONDAY_CLIENT_SECRET="your_client_secret"
MONDAY_SIGNING_SECRET="your_signing_secret"

# ============================================================================
# ENCRYPTION & SECURITY
# ============================================================================

# 32-byte hex string for AES-256-CBC password encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_32_byte_hex_string"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Server port
PORT=3000

# Environment
NODE_ENV="development"

# SMTP defaults (Aruba Mail)
ARUBA_SMTP_HOST="mail.aruba.it"
ARUBA_SMTP_PORT=465

# Debug logging
DEBUG_EMAIL="false"

# CORS
CORS_ORIGIN="*"

# ============================================================================
# VERCEL DEPLOYMENT (copy these to Vercel dashboard)
# ============================================================================

# In Vercel Settings → Environment Variables, add:
# - DATABASE_URL (production database URL)
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY
# - MONDAY_CLIENT_SECRET
# - MONDAY_SIGNING_SECRET
# - ENCRYPTION_KEY
# - NODE_ENV=production
